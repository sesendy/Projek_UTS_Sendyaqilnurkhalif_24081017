
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GAJI KARYAWAN"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:padding="25dp"/>

        <Button
            android:id="@+id/btnGaji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GAJI PEGAWAI"
            android:layout_margin="10dp"/>

        <Button
            android:id="@+id/btnPetunjuk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PETUNJUK PENGGUNAAN"
            android:layout_margin="10dp"/>

        <Button
            android:id="@+id/btnTentang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TENTANG APLIKASI"
            android:layout_margin="10dp"/>

        <Button
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXIT"
            android:layout_margin="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="www.sandrio.com"
            android:textColor="#17365D"
            android:layout_marginTop="35dp"/>

    </LinearLayout>
</ScrollView>
